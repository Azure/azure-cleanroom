f5738e7</b:FlowGuid><b:Id>67</b:Id><b:InteractionKey>b2a87160-60e4-58a1-a2a7-9f18dea9d135:6fcde369-60fb-400b-843f-4c06bf5738e7:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Excessive Resource Consumption</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Clean Room Spark Service (TEE) or AKS Cluster (managed RG) take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[X4] Launch per-query pods</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2a87160-60e4-58a1-a2a7-9f18dea9d135</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6b2a87160-60e4-58a1-a2a7-9f18dea9d1356fcde369-60fb-400b-843f-4c06bf5738e7f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6fcde369-60fb-400b-843f-4c06bf5738e7</b:FlowGuid><b:Id>66</b:Id><b:InteractionKey>b2a87160-60e4-58a1-a2a7-9f18dea9d135:6fcde369-60fb-400b-843f-4c06bf5738e7:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [X4] Launch per-query pods may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[X4] Launch per-query pods</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2a87160-60e4-58a1-a2a7-9f18dea9d135</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I5b2a87160-60e4-58a1-a2a7-9f18dea9d1356fcde369-60fb-400b-843f-4c06bf5738e7f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6fcde369-60fb-400b-843f-4c06bf5738e7</b:FlowGuid><b:Id>65</b:Id><b:InteractionKey>b2a87160-60e4-58a1-a2a7-9f18dea9d135:6fcde369-60fb-400b-843f-4c06bf5738e7:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Improper Resource Allocation and Deallocation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Is transient and persistent storage initialized before use? If data is not, it may contain data from a previous allocation that may be disclosed to an attacker. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[X4] Launch per-query pods</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2a87160-60e4-58a1-a2a7-9f18dea9d135</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1b2a87160-60e4-58a1-a2a7-9f18dea9d1356fcde369-60fb-400b-843f-4c06bf5738e7f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6fcde369-60fb-400b-843f-4c06bf5738e7</b:FlowGuid><b:Id>64</b:Id><b:InteractionKey>b2a87160-60e4-58a1-a2a7-9f18dea9d135:6fcde369-60fb-400b-843f-4c06bf5738e7:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of a Destination Data Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>AKS Cluster (managed RG) may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of AKS Cluster (managed RG). Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[X4] Launch per-query pods</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2a87160-60e4-58a1-a2a7-9f18dea9d135</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6b2a87160-60e4-58a1-a2a7-9f18dea9d1357c018d6f-8f51-4b1c-ad0c-0e9ed32a4892a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>7c018d6f-8f51-4b1c-ad0c-0e9ed32a4892</b:FlowGuid><b:Id>47</b:Id><b:InteractionKey>b2a87160-60e4-58a1-a2a7-9f18dea9d135:7c018d6f-8f51-4b1c-ad0c-0e9ed32a4892:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [X5] Per-query secret + consent check may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[X5] Per-query secret + consent check</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2a87160-60e4-58a1-a2a7-9f18dea9d135</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5b2a87160-60e4-58a1-a2a7-9f18dea9d1357c018d6f-8f51-4b1c-ad0c-0e9ed32a4892a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>7c018d6f-8f51-4b1c-ad0c-0e9ed32a4892</b:FlowGuid><b:Id>48</b:Id><b:InteractionKey>b2a87160-60e4-58a1-a2a7-9f18dea9d135:7c018d6f-8f51-4b1c-ad0c-0e9ed32a4892:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Clean Room Governance Service (CCF, TEE) may be able to impersonate the context of Clean Room Spark Service (TEE) in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[X5] Per-query secret + consent check</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b2a87160-60e4-58a1-a2a7-9f18dea9d135</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1a3d31e42-abac-53ab-9b3a-a9a2dfc558235338e2ff-223f-4d47-82a6-85b865af891b6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>5338e2ff-223f-4d47-82a6-85b865af891b</b:FlowGuid><b:Id>49</b:Id><b:InteractionKey>a3d31e42-abac-53ab-9b3a-a9a2dfc55823:5338e2ff-223f-4d47-82a6-85b865af891b:6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of a Destination Data Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>CCF Private Ledger may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of CCF Private Ledger. Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>audit append</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I5a3d31e42-abac-53ab-9b3a-a9a2dfc558235338e2ff-223f-4d47-82a6-85b865af891b6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>5338e2ff-223f-4d47-82a6-85b865af891b</b:FlowGuid><b:Id>50</b:Id><b:InteractionKey>a3d31e42-abac-53ab-9b3a-a9a2dfc55823:5338e2ff-223f-4d47-82a6-85b865af891b:6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Improper Resource Allocation and Deallocation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Is transient and persistent storage initialized before use? If data is not, it may contain data from a previous allocation that may be disclosed to an attacker. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>audit append</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6a3d31e42-abac-53ab-9b3a-a9a2dfc558235338e2ff-223f-4d47-82a6-85b865af891b6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>5338e2ff-223f-4d47-82a6-85b865af891b</b:FlowGuid><b:Id>51</b:Id><b:InteractionKey>a3d31e42-abac-53ab-9b3a-a9a2dfc55823:5338e2ff-223f-4d47-82a6-85b865af891b:6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across audit append may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>audit append</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2a3d31e42-abac-53ab-9b3a-a9a2dfc558235338e2ff-223f-4d47-82a6-85b865af891b6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>5338e2ff-223f-4d47-82a6-85b865af891b</b:FlowGuid><b:Id>52</b:Id><b:InteractionKey>a3d31e42-abac-53ab-9b3a-a9a2dfc55823:5338e2ff-223f-4d47-82a6-85b865af891b:6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Excessive Resource Consumption</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Clean Room Governance Service (CCF, TEE) or CCF Private Ledger take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>audit append</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5a3d31e42-abac-53ab-9b3a-a9a2dfc558235338e2ff-223f-4d47-82a6-85b865af891b6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>5338e2ff-223f-4d47-82a6-85b865af891b</b:FlowGuid><b:Id>53</b:Id><b:InteractionKey>a3d31e42-abac-53ab-9b3a-a9a2dfc55823:5338e2ff-223f-4d47-82a6-85b865af891b:6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external threat agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>audit append</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>6a4ea9c9-fa09-5d85-a55e-7ec06776c6a9</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6e730590e-e777-5fca-8bbc-aaff24c6342616b823ae-71b4-4f10-bd1f-01066b9cdba1a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>16b823ae-71b4-4f10-bd1f-01066b9cdba1</b:FlowGuid><b:Id>59</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:16b823ae-71b4-4f10-bd1f-01066b9cdba1:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [R2] Recover CCF network may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R2] Recover CCF network</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5e730590e-e777-5fca-8bbc-aaff24c6342616b823ae-71b4-4f10-bd1f-01066b9cdba1a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>16b823ae-71b4-4f10-bd1f-01066b9cdba1</b:FlowGuid><b:Id>60</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:16b823ae-71b4-4f10-bd1f-01066b9cdba1:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Clean Room Governance Service (CCF, TEE) may be able to impersonate the context of Confidential Recovery Service (TEE) in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R2] Recover CCF network</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S32c7da165-f572-5ffd-9d24-5559d5ebbd5dcc578987-ffa8-4958-87f6-7a7b8475196fa3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>cc578987-ffa8-4958-87f6-7a7b8475196f</b:FlowGuid><b:Id>61</b:Id><b:InteractionKey>2c7da165-f572-5ffd-9d24-5559d5ebbd5d:cc578987-ffa8-4958-87f6-7a7b8475196f:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of an External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Collaborator User (Fabrikam / Contoso) may be spoofed by an attacker and this may lead to unauthorized access to Clean Room Governance Service (CCF, TEE). Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[A1] Audit / query listing / vote (collaborator JWT - direct, bypasses FE)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2c7da165-f572-5ffd-9d24-5559d5ebbd5d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I62c7da165-f572-5ffd-9d24-5559d5ebbd5dcc578987-ffa8-4958-87f6-7a7b8475196fa3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>cc578987-ffa8-4958-87f6-7a7b8475196f</b:FlowGuid><b:Id>62</b:Id><b:InteractionKey>2c7da165-f572-5ffd-9d24-5559d5ebbd5d:cc578987-ffa8-4958-87f6-7a7b8475196f:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [A1] Audit / query listing / vote (collaborator JWT - direct, bypasses FE) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[A1] Audit / query listing / vote (collaborator JWT - direct, bypasses FE)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2c7da165-f572-5ffd-9d24-5559d5ebbd5d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E52c7da165-f572-5ffd-9d24-5559d5ebbd5dcc578987-ffa8-4958-87f6-7a7b8475196fa3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>cc578987-ffa8-4958-87f6-7a7b8475196f</b:FlowGuid><b:Id>63</b:Id><b:InteractionKey>2c7da165-f572-5ffd-9d24-5559d5ebbd5d:cc578987-ffa8-4958-87f6-7a7b8475196f:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Clean Room Governance Service (CCF, TEE) may be able to impersonate the context of Collaborator User (Fabrikam / Contoso) in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[A1] Audit / query listing / vote (collaborator JWT - direct, bypasses FE)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2c7da165-f572-5ffd-9d24-5559d5ebbd5d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.1e730590e-e777-5fca-8bbc-aaff24c63426dbd0335d-4580-4780-bf18-1c84b69e59b57efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>dbd0335d-4580-4780-bf18-1c84b69e59b5</b:FlowGuid><b:Id>69</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:dbd0335d-4580-4780-bf18-1c84b69e59b5:7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of a Destination Data Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Customer Recovery AKV (SKR-policied) may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of Customer Recovery AKV (SKR-policied). Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R1] SKR recovery key</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I5e730590e-e777-5fca-8bbc-aaff24c63426dbd0335d-4580-4780-bf18-1c84b69e59b57efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>dbd0335d-4580-4780-bf18-1c84b69e59b5</b:FlowGuid><b:Id>70</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:dbd0335d-4580-4780-bf18-1c84b69e59b5:7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Improper Resource Allocation and Deallocation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Is transient and persistent storage initialized before use? If data is not, it may contain data from a previous allocation that may be disclosed to an attacker. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R1] SKR recovery key</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6e730590e-e777-5fca-8bbc-aaff24c63426dbd0335d-4580-4780-bf18-1c84b69e59b57efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>dbd0335d-4580-4780-bf18-1c84b69e59b5</b:FlowGuid><b:Id>71</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:dbd0335d-4580-4780-bf18-1c84b69e59b5:7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [R1] SKR recovery key may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R1] SKR recovery key</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2e730590e-e777-5fca-8bbc-aaff24c63426dbd0335d-4580-4780-bf18-1c84b69e59b57efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>dbd0335d-4580-4780-bf18-1c84b69e59b5</b:FlowGuid><b:Id>72</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:dbd0335d-4580-4780-bf18-1c84b69e59b5:7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Excessive Resource Consumption</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Confidential Recovery Service (TEE) or Customer Recovery AKV (SKR-policied) take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R1] SKR recovery key</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5e730590e-e777-5fca-8bbc-aaff24c63426dbd0335d-4580-4780-bf18-1c84b69e59b57efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>dbd0335d-4580-4780-bf18-1c84b69e59b5</b:FlowGuid><b:Id>73</b:Id><b:InteractionKey>e730590e-e777-5fca-8bbc-aaff24c63426:dbd0335d-4580-4780-bf18-1c84b69e59b5:7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external threat agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[R1] SKR recovery key</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>e730590e-e777-5fca-8bbc-aaff24c63426</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>7efe963e-e17e-5d0b-9b04-bac1f5eaa0e1</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:Type