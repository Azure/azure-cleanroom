ngstring><a:Key>InteractionString</a:Key><a:Value>[G2] SKR member key (SNP report -&gt; MAA -&gt; AKV)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I5b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4fa2c83c9-314f-4b4e-90b6-7515541f020431da3fa5-fc8e-5447-aaef-2d9c46e8b588</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>fa2c83c9-314f-4b4e-90b6-7515541f0204</b:FlowGuid><b:Id>19</b:Id><b:InteractionKey>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4:fa2c83c9-314f-4b4e-90b6-7515541f0204:31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Improper Resource Allocation and Deallocation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Is transient and persistent storage initialized before use? If data is not, it may contain data from a previous allocation that may be disclosed to an attacker. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[G2] SKR member key (SNP report -&gt; MAA -&gt; AKV)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4fa2c83c9-314f-4b4e-90b6-7515541f020431da3fa5-fc8e-5447-aaef-2d9c46e8b588</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>fa2c83c9-314f-4b4e-90b6-7515541f0204</b:FlowGuid><b:Id>20</b:Id><b:InteractionKey>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4:fa2c83c9-314f-4b4e-90b6-7515541f0204:31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [G2] SKR member key (SNP report -&gt; MAA -&gt; AKV) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[G2] SKR member key (SNP report -&gt; MAA -&gt; AKV)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D2b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4fa2c83c9-314f-4b4e-90b6-7515541f020431da3fa5-fc8e-5447-aaef-2d9c46e8b588</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>fa2c83c9-314f-4b4e-90b6-7515541f0204</b:FlowGuid><b:Id>21</b:Id><b:InteractionKey>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4:fa2c83c9-314f-4b4e-90b6-7515541f0204:31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Excessive Resource Consumption</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Consortium Manager (TEE) sole AME-side CCF member or AME AKV + mHSM (SKR-policied) take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[G2] SKR member key (SNP report -&gt; MAA -&gt; AKV)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D5b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4fa2c83c9-314f-4b4e-90b6-7515541f020431da3fa5-fc8e-5447-aaef-2d9c46e8b588</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>fa2c83c9-314f-4b4e-90b6-7515541f0204</b:FlowGuid><b:Id>22</b:Id><b:InteractionKey>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4:fa2c83c9-314f-4b4e-90b6-7515541f0204:31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external threat agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[G2] SKR member key (SNP report -&gt; MAA -&gt; AKV)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>31da3fa5-fc8e-5447-aaef-2d9c46e8b588</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4d7ac9e15-8eb8-4b15-8b7e-dbac5fa4e150a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>d7ac9e15-8eb8-4b15-8b7e-dbac5fa4e150</b:FlowGuid><b:Id>23</b:Id><b:InteractionKey>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4:d7ac9e15-8eb8-4b15-8b7e-dbac5fa4e150:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [G3] Join CCF + propose/accept contracts, policies, member changes (member cert) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[G3] Join CCF + propose/accept contracts, policies, member changes (member cert)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4d7ac9e15-8eb8-4b15-8b7e-dbac5fa4e150a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>d7ac9e15-8eb8-4b15-8b7e-dbac5fa4e150</b:FlowGuid><b:Id>24</b:Id><b:InteractionKey>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4:d7ac9e15-8eb8-4b15-8b7e-dbac5fa4e150:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Clean Room Governance Service (CCF, TEE) may be able to impersonate the context of Consortium Manager (TEE) sole AME-side CCF member in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[G3] Join CCF + propose/accept contracts, policies, member changes (member cert)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>b610eb86-ba2d-5114-a63d-7d1f7f8fa6f4</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S32c7da165-f572-5ffd-9d24-5559d5ebbd5dd6b58d43-9405-443a-8f6d-e398f67838d01ba6be3f-7a39-5daf-8534-acd1247a5d2a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>d6b58d43-9405-443a-8f6d-e398f67838d0</b:FlowGuid><b:Id>25</b:Id><b:InteractionKey>2c7da165-f572-5ffd-9d24-5559d5ebbd5d:d6b58d43-9405-443a-8f6d-e398f67838d0:1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of an External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Collaborator User (Fabrikam / Contoso) may be spoofed by an attacker and this may lead to unauthorized access to Workload Frontend (NOT a CCF member). Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[D1] Execute query, submit governance-write (HTTPS + Entra token)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2c7da165-f572-5ffd-9d24-5559d5ebbd5d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I62c7da165-f572-5ffd-9d24-5559d5ebbd5dd6b58d43-9405-443a-8f6d-e398f67838d01ba6be3f-7a39-5daf-8534-acd1247a5d2a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>d6b58d43-9405-443a-8f6d-e398f67838d0</b:FlowGuid><b:Id>26</b:Id><b:InteractionKey>2c7da165-f572-5ffd-9d24-5559d5ebbd5d:d6b58d43-9405-443a-8f6d-e398f67838d0:1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [D1] Execute query, submit governance-write (HTTPS + Entra token) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[D1] Execute query, submit governance-write (HTTPS + Entra token)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2c7da165-f572-5ffd-9d24-5559d5ebbd5d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E52c7da165-f572-5ffd-9d24-5559d5ebbd5dd6b58d43-9405-443a-8f6d-e398f67838d01ba6be3f-7a39-5daf-8534-acd1247a5d2a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>d6b58d43-9405-443a-8f6d-e398f67838d0</b:FlowGuid><b:Id>27</b:Id><b:InteractionKey>2c7da165-f572-5ffd-9d24-5559d5ebbd5d:d6b58d43-9405-443a-8f6d-e398f67838d0:1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Workload Frontend (NOT a CCF member) may be able to impersonate the context of Collaborator User (Fabrikam / Contoso) in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[D1] Execute query, submit governance-write (HTTPS + Entra token)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>2c7da165-f572-5ffd-9d24-5559d5ebbd5d</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S315c101a7-ee75-591e-8249-f086af649aea01331a93-4ace-4b72-9647-7f5bf970faa71ba6be3f-7a39-5daf-8534-acd1247a5d2a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>01331a93-4ace-4b72-9647-7f5bf970faa7</b:FlowGuid><b:Id>28</b:Id><b:InteractionKey>15c101a7-ee75-591e-8249-f086af649aea:01331a93-4ace-4b72-9647-7f5bf970faa7:1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of an External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Clean Room Owner (Litware) may be spoofed by an attacker and this may lead to unauthorized access to Workload Frontend (NOT a CCF member). Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[D1] Owner dataplane ops</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>15c101a7-ee75-591e-8249-f086af649aea</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I615c101a7-ee75-591e-8249-f086af649aea01331a93-4ace-4b72-9647-7f5bf970faa71ba6be3f-7a39-5daf-8534-acd1247a5d2a</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>01331a93-4ace-4b72-9647-7f5bf970faa7</b:FlowGuid><b:Id>29</b:Id><b:InteractionKey>15c101a7-ee75-591e-8249-f086af649aea:01331a93-4ace-4b72-9647-7f5bf970faa7:1ba6be3f-7a39-5daf-8534-acd1247a5d2a</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [D1] Owner dataplane ops may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[D1] Owner dataplane ops</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>15c101a7-ee75-591e-8249-f086af649aea</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:T