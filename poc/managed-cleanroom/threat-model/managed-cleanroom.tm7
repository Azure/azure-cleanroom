ndex>0</b:SelectedIndex></a:anyType><a:anyType i:type="b:ListDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Provides Confidentiality</b:DisplayName><b:Name>providesConfidentiality</b:Name><b:Value i:type="a:ArrayOfstring"><a:string>No</a:string><a:string>Yes</a:string></b:Value><b:SelectedIndex>0</b:SelectedIndex></a:anyType><a:anyType i:type="b:ListDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Provides Integrity</b:DisplayName><b:Name>providesIntegrity</b:Name><b:Value i:type="a:ArrayOfstring"><a:string>No</a:string><a:string>Yes</a:string></b:Value><b:SelectedIndex>0</b:SelectedIndex></a:anyType><a:anyType i:type="b:ListDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>Max Data Sensitivity</b:DisplayName><b:Name>MaxDataSensitivity</b:Name><b:Value i:type="a:ArrayOfstring"><a:string>Not Selected</a:string><a:string>Compliance</a:string><a:string>HBI</a:string><a:string>MBI</a:string><a:string>LBI</a:string><a:string>Public</a:string></b:Value><b:SelectedIndex>0</b:SelectedIndex></a:anyType><a:anyType i:type="b:ListDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>AccessCapabilityRequired</b:DisplayName><b:Name>CapabilityRequired</b:Name><b:Value i:type="a:ArrayOfstring"><a:string>CapabilityRequired</a:string></b:Value><b:SelectedIndex>0</b:SelectedIndex></a:anyType><a:anyType i:type="b:ListDisplayAttribute" xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:DisplayName>XMLEncoded</b:DisplayName><b:Name>XMLenc</b:Name><b:Value i:type="a:ArrayOfstring"><a:string>No</a:string><a:string>Yes</a:string></b:Value><b:SelectedIndex>0</b:SelectedIndex></a:anyType></Properties><TypeId xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">GE.DF</TypeId><HandleX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1599</HandleX><HandleY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">871</HandleY><PortSource xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">East</PortSource><PortTarget xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">South</PortTarget><SourceGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">b2a87160-60e4-58a1-a2a7-9f18dea9d135</SourceGuid><SourceX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1381</SourceX><SourceY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">984</SourceY><TargetGuid xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">fb145933-6e7d-550e-9203-e715fce85c3e</TargetGuid><TargetX xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">1629</TargetX><TargetY xmlns="http://schemas.datacontract.org/2004/07/ThreatModeling.Model.Abstracts">691</TargetY></a:Value></a:KeyValueOfguidanyType></Lines><Zoom>0.5</Zoom></DrawingSurfaceModel></DrawingSurfaceList><MetaInformation><Assumptions>A1 - AMD SEV-SNP hardware attestation is trustworthy (root of trust). Verified by MAA.
A2 - The CCE policy generated for each container group correctly measures OCI layers, command-lines, and allowed env vars (see build/templates/**/*.json).
A3 - Container images in MCR match the source in GitHub. Verified via `gh attestation verify` (SLSA provenance). See security.md - Commit signing.
A4 - Customer AKV / mHSM instances holding SKR-policied secrets are administered by the customer under normal Azure security posture (RBAC, MFA on admins, etc.).
A5 - The Microsoft.CleanRoom RP is operated behind Azure RPaaS. RPaaS enforces standard controls: deny-assignments on managed RG, single first-party app onboarding per RP, region-scoped internal MI per region.
A6 - Entra ID, MAA, ARM, MCR, GitHub, Azure DNS, Azure Storage, Azure Key Vault are trusted Azure platform services (out of scope for STRIDE).
A7 - Physical security of Azure DCs and hypervisor integrity are Azure platform concerns (out of scope).</Assumptions><Contributors>Anant Shankar; Dev Baburaj; Md Danish</Contributors><ExternalDependencies>E1 - Microsoft Entra ID: user, MI, first-party app authn; OIDC federation for Spark driver to customer AKV.
E2 - Microsoft Azure Attestation (MAA): verifies SNP attestation reports; enforces `host_data` policy for SKR.
E3 - Azure Resource Manager + RPaaS: fronts the RP; performs managed-RG deny-assignment; onboards single first-party app per RP.
E4 - Microsoft Container Registry (MCR): container image distribution for RP and confidential dataplane.
E5 - GitHub: source of truth for code; publishes SLSA attestations tying image digest to source commit.
E6 - Customer Azure Key Vault / mHSM (per collaborator): holds dataset encryption keys; releases via SKR when SNP attestation matches CCE `host_data`.
E7 - Customer Azure Storage / on-prem storage: holds encrypted datasets consumed by the clean room.
E8 - Azure DNS + Private DNS Zones: service discovery inside the customer VNet.</ExternalDependencies><HighLevelSystemDescription>Managed Azure Clean Rooms is a first-party Azure service (Microsoft.CleanRoom RP behind RPaaS) that lets two or more organisations collaborate on privacy-sensitive data (analytics) inside SEV-SNP-backed confidential compute.

Microsoft operates the control plane; the confidential workloads run inside the clean-room owner's Azure subscription in a managed resource group whose write access is denied to everyone (RPaaS deny-assignment) except the single RPaaS-onboarded first-party app.

Core guarantees:
- Confidentiality of collaborator data through SEV-SNP hardware attestation and remote-attested Secure Key Release (SKR) from customer-owned Azure Key Vault.
- Ledger-backed multi-party governance through a Confidential Consortium Framework (CCF) instance called Clean Room Governance Service (CGS), where each contract (dataset publish, query publish, execute consent) requires multi-member voting. The Consortium Manager (in AME) is the sole AME-side CCF member; the Workload Frontend is NOT a CCF member and forwards governance-write requests to the Consortium Manager.
- Auditability through a signed ledger; collaborators query audit history and vote via their own JWT direct to CGS (bypassing the AME frontend).
- Zero-Trust between AME and customers: no code path in AME can read a collaborator's plaintext data.

See companion SPEC.md and system-overview.md in this folder, and poc/managed-cleanroom/README.md + security.md for detailed design.</HighLevelSystemDescription><Owner>Clean Rooms Engineering (AME)</Owner><Reviewer>Casaba Security</Reviewer><ThreatModelName>Managed Azure Clean Rooms (1P)</ThreatModelName></MetaInformation><Notes/><ThreatInstances xmlns:a="http://schemas.microsoft.com/2003/10/Serialization/Arrays"><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S3746b0638-8394-56a9-852c-97eb35a23d908728b864-a023-4b35-bdb4-c8fa7b0f4ad15f4e79e5-a803-57fa-ab48-f87c9107dadc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>8728b864-a023-4b35-bdb4-c8fa7b0f4ad1</b:FlowGuid><b:Id>1</b:Id><b:InteractionKey>746b0638-8394-56a9-852c-97eb35a23d90:8728b864-a023-4b35-bdb4-c8fa7b0f4ad1:5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of an External Entity</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Azure Resource Manager + RPaaS may be spoofed by an attacker and this may lead to unauthorized access to Clean Room RP + per-service Managers. Consider using a standard authentication mechanism to identify the external entity.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S1] Forward ARM op</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>746b0638-8394-56a9-852c-97eb35a23d90</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S3</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I6746b0638-8394-56a9-852c-97eb35a23d908728b864-a023-4b35-bdb4-c8fa7b0f4ad15f4e79e5-a803-57fa-ab48-f87c9107dadc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>8728b864-a023-4b35-bdb4-c8fa7b0f4ad1</b:FlowGuid><b:Id>2</b:Id><b:InteractionKey>746b0638-8394-56a9-852c-97eb35a23d90:8728b864-a023-4b35-bdb4-c8fa7b0f4ad1:5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [S1] Forward ARM op may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S1] Forward ARM op</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>746b0638-8394-56a9-852c-97eb35a23d90</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>E5746b0638-8394-56a9-852c-97eb35a23d908728b864-a023-4b35-bdb4-c8fa7b0f4ad15f4e79e5-a803-57fa-ab48-f87c9107dadc</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>8728b864-a023-4b35-bdb4-c8fa7b0f4ad1</b:FlowGuid><b:Id>3</b:Id><b:InteractionKey>746b0638-8394-56a9-852c-97eb35a23d90:8728b864-a023-4b35-bdb4-c8fa7b0f4ad1:5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Elevation Using Impersonation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Elevation Of Privilege</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>A user subject gains increased capability or privilege by taking advantage of an implementation bug.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Clean Room RP + per-service Managers may be able to impersonate the context of Azure Resource Manager + RPaaS in order to gain additional privilege.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S1] Forward ARM op</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>746b0638-8394-56a9-852c-97eb35a23d90</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>E5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>S7.15f4e79e5-a803-57fa-ab48-f87c9107dadc6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9</b:FlowGuid><b:Id>4</b:Id><b:InteractionKey>5f4e79e5-a803-57fa-ab48-f87c9107dadc:6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Spoofing of a Destination Data Store</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Spoofing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Spoofing is when a process or entity is something other than its claimed identity. Examples include substituting a process, a file, website or a network address.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>AKS Cluster (managed RG) may be spoofed by an attacker and this may lead to data being written to the attacker's target instead of AKS Cluster (managed RG). Consider using a standard authentication mechanism to identify the destination data store.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S2] Provision AKS + VNet (RPaaS 1P app)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>S7.1</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I55f4e79e5-a803-57fa-ab48-f87c9107dadc6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9</b:FlowGuid><b:Id>5</b:Id><b:InteractionKey>5f4e79e5-a803-57fa-ab48-f87c9107dadc:6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Improper Resource Allocation and Deallocation</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Is transient and persistent storage initialized before use? If data is not, it may contain data from a previous allocation that may be disclosed to an attacker. </a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S2] Provision AKS + VNet (RPaaS 1P app)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I65f4e79e5-a803-57fa-ab48-f87c9107dadc6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9</b:FlowGuid><b:Id>6</b:Id><b:InteractionKey>5f4e79e5-a803-57fa-ab48-f87c9107dadc:6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Flow Sniffing</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Information Disclosure</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Information disclosure happens when the information can be read by an unauthorized party.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Data flowing across [S2] Provision AKS + VNet (RPaaS 1P app) may be sniffed by an attacker. Depending on what type of data an attacker can read, it may be used to attack other parts of the system or simply be a disclosure of information leading to compliance violations. Consider encrypting the data flow.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S2] Provision AKS + VNet (RPaaS 1P app)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>I6</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D25f4e79e5-a803-57fa-ab48-f87c9107dadc6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9</b:FlowGuid><b:Id>7</b:Id><b:InteractionKey>5f4e79e5-a803-57fa-ab48-f87c9107dadc:6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Excessive Resource Consumption</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>Does Clean Room RP + per-service Managers or AKS Cluster (managed RG) take explicit steps to control resource consumption? Resource consumption attacks can be hard to deal with, and there are times that it makes sense to let the OS do the job. Be careful that your resource requests don't deadlock, and that they do timeout.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S2] Provision AKS + VNet (RPaaS 1P app)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D2</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>D55f4e79e5-a803-57fa-ab48-f87c9107dadc6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9f69eb68c-80a1-5c61-ae90-a36169dd9617</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9</b:FlowGuid><b:Id>8</b:Id><b:InteractionKey>5f4e79e5-a803-57fa-ab48-f87c9107dadc:6910570d-f7e5-4ea1-b2d6-2f0910ea9fb9:f69eb68c-80a1-5c61-ae90-a36169dd9617</b:InteractionKey><b:InteractionString i:nil="true"/><b:ModifiedAt>0001-01-01T00:00:00</b:ModifiedAt><b:Priority>High</b:Priority><b:Properties><a:KeyValueOfstringstring><a:Key>Title</a:Key><a:Value>Data Store Inaccessible</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatCategory</a:Key><a:Value>Denial Of Service</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatShortDescription</a:Key><a:Value>Denial of Service happens when the process or a datastore is not able to service incoming requests or perform up to spec.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>UserThreatDescription</a:Key><a:Value>An external threat agent prevents access to a data store on the other side of the trust boundary.</a:Value></a:KeyValueOfstringstring><a:KeyValueOfstringstring><a:Key>InteractionString</a:Key><a:Value>[S2] Provision AKS + VNet (RPaaS 1P app)</a:Value></a:KeyValueOfstringstring></b:Properties><b:SourceGuid>5f4e79e5-a803-57fa-ab48-f87c9107dadc</b:SourceGuid><b:State>AutoGenerated</b:State><b:StateInformation i:nil="true"/><b:TargetGuid>f69eb68c-80a1-5c61-ae90-a36169dd9617</b:TargetGuid><b:Title i:nil="true"/><b:TypeId>D5</b:TypeId><b:Upgraded>false</b:Upgraded><b:UserThreatCategory i:nil="true"/><b:UserThreatDescription i:nil="true"/><b:UserThreatShortDescription i:nil="true"/><b:Wide>false</b:Wide></a:Value></a:KeyValueOfstringThreatpc_P0_PhOB><a:KeyValueOfstringThreatpc_P0_PhOB><a:Key>I65f4e79e5-a803-57fa-ab48-f87c9107dadc7a412dfb-d395-4bc6-b146-f0c880fa1278a3d31e42-abac-53ab-9b3a-a9a2dfc55823</a:Key><a:Value xmlns:b="http://schemas.datacontract.org/2004/07/ThreatModeling.KnowledgeBase"><b:ChangedBy i:nil="true"/><b:DrawingSurfaceGuid>b88a78ae-0ac8-53bb-80ba-80142812fb50</b:DrawingSurfaceGuid><b:FlowGuid>7a412dfb-d395-4bc6-b146-f0c880fa1278</b:FlowGuid><b:Id>9</b:Id><b:InteractionKey>5f4e79e5-a803-57fa-ab48-f87c9107dadc:7a412dfb-d395-4bc6-b146-f0c880fa1278:a3d31e42-abac-53ab-9b3a-a9a2dfc55823</b:InteractionKey><b:InteractionString i:nil="true"/><b: