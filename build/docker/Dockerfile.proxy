FROM cleanroombuild.azurecr.io/mirror/docker/library/python:3.12 AS wheel-builder

ARG UV_DEFAULT_INDEX=https://pypi.org/simple
ENV UV_DEFAULT_INDEX=$UV_DEFAULT_INDEX

WORKDIR /build

RUN apt-get update && apt-get install -y curl build-essential && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

COPY src/proxy/render-config src/proxy/render-config
COPY pyproject.toml .
COPY uv.lock .
RUN uv lock && uv sync --frozen
RUN uv build --package render-config --wheel

FROM mcr.microsoft.com/oss/envoyproxy/envoy:v1.33.0

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=$PIP_INDEX_URL

RUN apt-get update && apt-get install -y --no-install-recommends gettext jq python3 python3-pip curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /setup
COPY --from=wheel-builder /build/dist/render_config*.whl /setup/
RUN pip install --no-cache-dir /setup/*.whl && rm -rf /setup

WORKDIR "/home/envoy"

COPY src/proxy/ccr-proxy-config.yaml ccr-proxy-config.yaml
COPY src/proxy/cleanroom.cnf cleanroom.cnf
COPY src/proxy/bootstrap.sh bootstrap.sh
COPY src/proxy/templates templates
RUN chmod +x bootstrap.sh

COPY src/proxy/https-http/ccr-https-http-proxy-config.yaml https-http/ccr-https-http-proxy-config.yaml
COPY src/proxy/https-http/cert-config.cnf https-http/cert-config.cnf
COPY src/proxy/https-http/bootstrap.sh https-http/bootstrap.sh
COPY src/proxy/https-http-inference-proxy/envoy-config.yaml https-http-inference-proxy/envoy-config.yaml
COPY src/proxy/https-http-inference-proxy/bootstrap.sh https-http-inference-proxy/bootstrap.sh
COPY src/proxy/l4-lb/bootstrap.sh l4-lb/bootstrap.sh
COPY src/scripts/wait-for-it.sh wait-for-it.sh
RUN chmod +x https-http/bootstrap.sh https-http-inference-proxy/bootstrap.sh l4-lb/bootstrap.sh wait-for-it.sh