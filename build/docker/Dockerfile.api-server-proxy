# Build stage
FROM cleanroombuild.azurecr.io/mirror/docker/library/golang:1.26-alpine AS builder

RUN apk --no-cache add curl
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b $(go env GOPATH)/bin v2.11.0

WORKDIR /app

# Copy go mod files first (changes less frequently).
COPY go.mod go.sum ./
RUN go mod download

COPY .golangci.yml .

# Copy only the Go source files needed for the build.
COPY src/k8s-node/api-server-proxy/ ./src/k8s-node/api-server-proxy/

# Lint and build the binary for linux/amd64.
RUN golangci-lint run -v -c .golangci.yml ./src/k8s-node/api-server-proxy/...
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w" \
    -o /api-server-proxy \
    ./src/k8s-node/api-server-proxy/cmd/api-server-proxy

# Output stage — export just the binary.
FROM scratch AS dist
COPY --from=builder /api-server-proxy /api-server-proxy
