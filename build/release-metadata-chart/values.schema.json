{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ReleaseMetadata",
  "description": "Versioned cleanroom release metadata contract carried in values.yaml.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "images"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Contract API version.",
      "const": "metadata.cleanroom.azure.com/v1"
    },
    "kind": {
      "type": "string",
      "const": "ReleaseMetadata"
    },
    "metadata": {
      "type": "object",
      "required": ["release"],
      "properties": {
        "release": {
          "type": "string",
          "description": "Release/catalog version; matches Chart.yaml version."
        },
        "published": {
          "type": "string",
          "description": "Publish date (ISO-8601), informational."
        }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "object",
      "description": "Logical image name -> DIGEST-pinned container reference.",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "description": "Digest-pinned reference, e.g. registry/path@sha256:<64 hex>.",
        "pattern": "^[^@]+@sha256:[a-f0-9]{64}$"
      }
    },
    "helm-charts": {
      "type": "object",
      "description": "Logical chart name -> OCI TAG reference.",
      "additionalProperties": {
        "type": "string",
        "description": "OCI tag reference, e.g. oci://registry/path:<tag>.",
        "pattern": "^oci://[^@]+:[A-Za-z0-9._-]+$"
      }
    },
    "artefacts": {
      "type": "object",
      "description": "Logical artefact name -> TAG reference (policy docs, js apps, constitutions, wheels).",
      "additionalProperties": {
        "type": "string",
        "description": "Tag reference, e.g. registry/path:<tag>.",
        "pattern": "^[^@]+:[A-Za-z0-9._-]+$"
      }
    }
  },
  "additionalProperties": true
}
