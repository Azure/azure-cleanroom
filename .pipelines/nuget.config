<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped NuGet config for the OneBranch Official build build_solutions job.
  The governed OneBranch linux pool (needed for CodeQL to trace native builds)
  firewalls public NuGet, so native dotnet restore there fails with NU1301.
  This points restores at the msazure Azure Artifacts feed azure-cleanroomservice
  (project msazure/One), reachable from the governed pool and upstreaming public
  NuGet Gallery, so it resolves internal plus public packages. Auth comes from the
  NuGetAuthenticate task. Referenced explicitly via the restore configfile flag
  only by build_solutions; the container image builds restore inside their own
  network-enabled Docker containers and do not use this file.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="azure-cleanroomservice" value="https://msazure.pkgs.visualstudio.com/One/_packaging/azure-cleanroomservice/nuget/v3/index.json" />
  </packageSources>
</configuration>
